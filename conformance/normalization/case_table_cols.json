  "input": "<style>\n  body { font-family: \"WeftRoboto\"; }\n  table { border-collapse: collapse; }\n  td, th { border: 1px solid #d0d7de; padding: 6px 10px; vertical-align: top; }\n  th { font-weight: 700; text-align: left; }\n  col.narrow { width: 80px; }\n  col.wide { width: 110px; }\n  col.share { width: 25%; }\n</style>\n<h2 data-geo=\"title\">Column track geometry baseline</h2>\n<table data-geo=\"t1\" style=\"width: 360px\">\n  <caption data-geo=\"cap\">Quarterly forecast</caption>\n  <colgroup>\n    <col class=\"narrow\">\n    <col class=\"wide\">\n  </colgroup>\n  <col class=\"share\">\n  <colgroup span=\"2\"></colgroup>\n  <thead>\n    <tr><th data-geo=\"h1\">Sku</th><th data-geo=\"h2\">Stock</th><th data-geo=\"h3\">Share</th><th data-geo=\"h4\">A</th><th data-geo=\"h5\">B</th></tr>\n  </thead>\n  <tbody>\n    <tr><td data-geo=\"r1\">North</td><td data-geo=\"u1\">1,240</td><td data-geo=\"v1\">48,200</td><td data-geo=\"w1\">A</td><td data-geo=\"x1\">B</td></tr>\n    <tr><td data-geo=\"r2\">South</td><td data-geo=\"u2\">2,410</td><td data-geo=\"v2\">31,900</td><td data-geo=\"w2\" colspan=\"2\">Merged</td></tr>\n  </tbody>\n</table>\n<p data-geo=\"after\">Paragraph after the tracked table.</p>\n",
